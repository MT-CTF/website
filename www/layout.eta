<!doctype html>
<html lang="en">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>Capture the Flag - Luanti</title>
	<link rel="icon" href="https://github.com/MT-CTF/capturetheflag/blob/master/menu/icon.png?raw=true" type="image/png">
	<link rel="stylesheet" href="public/output.css">
</head>

<body>
	<header>
		<a href="https://ctf.landarvargan.xyz" style="display:inline-block; margin-right: 24px;">
			<img id="header-image"
				style="max-width: 453px; width: 100%; height: auto;"
				alt="Capture The Flag"
				src="https://github.com/MT-CTF/capturetheflag/blob/master/menu/header.png?raw=true"
			/>
			<img id="header-icon"
				style="max-width: 52px; max-height: 90%; width: 100%; height: auto;"
				alt="CTF"
				src="https://github.com/MT-CTF/capturetheflag/blob/master/menu/icon.png?raw=true"
			/>
		</a>

		<nav>
			<a <%~ it.current_page === "index.eta" ? 'class="selected"' : "" %> href=".">Home</a>
			<a <%~ it.current_page === "rankings.eta" ? 'class="selected"' : "" %> href="./rankings">Rankings</a>
		</nav>
	</header>

	<%~ it.body %>

	<footer>
		<ul>
			<li>
				<p>&copy; 2022-2024 the CaptureTheFlag Team.</p>
				<a href="https://github.com/MT-CTF/website">Website Source (MIT)</a>
			</li>
			<li>
				<p>Images from the</p>
				<a href="https://github.com/MT-CTF/capturetheflag/tree/master/menu">CaptureTheFlag Github Repository</a>
			</li>
		</ul>
	</footer>
</body>

</html>